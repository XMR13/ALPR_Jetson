{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# YOLOX Plate Training (Kaggle)\n",
    "High-accuracy fine-tuning for Indonesian license plates. Configure paths below, then run all."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Configuration — set to your Kaggle input paths\n",
    "DATA_DIR = '/kaggle/input/alpr-first-trial'  # change to your dataset slug\n",
    "TRAIN_JSON = 'annotations/instances_Train.json'\n",
    "VAL_JSON = 'annotations/instances_Validation.json'\n",
    "TRAIN_NAME = 'images/Train'\n",
    "VAL_NAME = 'images/Validation'\n",
    "\n",
    "# Optional pretrained weights (recommended)\n",
    "# If you attached a dataset with YOLOX_S.pth, set path below; else leave empty to train from scratch.\n",
    "PRETRAIN_CKPT = '/kaggle/input/yolox-weights/YOLOX_S.pth'  # or '' if not available\n",
    "\n",
    "# Training params\n",
    "EPOCHS = 80\n",
    "NO_AUG_EPOCHS = 15\n",
    "BATCH = 16\n",
    "EXPN = 'yolox_s_lp'\n",
    "SEED = 42\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Install dependencies (Internet ON recommended).\n",
    "!pip -q install yolox==0.3.0 onnx onnxsim pycocotools pillow tensorboard >/dev/null"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Write the tuned YOLOX experiment file used in this project\n",
    "import os, textwrap, pathlib\n",
    "exp_dir = pathlib.Path('exps/yolox')\n",
    "exp_dir.mkdir(parents=True, exist_ok=True)\n",
    "exp_code = textwrap.dedent('''\n",
    "from __future__ import annotations\n",
    "import os\n",
    "from yolox.exp import Exp as _BaseExp\n",
    "\n",
    "class Exp(_BaseExp):\n",
    "    def __init__(self) -> None:\n",
    "        super().__init__()\n",
    "        self.depth = 0.33\n",
    "        self.width = 0.50\n",
    "        self.input_size = (640, 640)\n",
    "        self.test_size = (640, 640)\n",
    "        self.num_classes = 1\n",
    "        # schedule\n",
    "        self.max_epoch = int(os.getenv('YOLOX_MAX_EPOCH', '80'))\n",
    "        self.no_aug_epochs = int(os.getenv('YOLOX_NO_AUG', '15'))\n",
    "        self.warmup_epochs = 3\n",
    "        self.basic_lr_per_img = 0.01 / 64.0\n",
    "        self.eval_interval = 1\n",
    "        self.print_interval = 50\n",
    "        self.data_num_workers = 4\n",
    "        # augs\n",
    "        self.random_size = (14, 26)\n",
    "        self.mosaic_prob = 0.7\n",
    "        self.mixup_prob = 0.05\n",
    "        self.hsv_prob = 1.0\n",
    "        self.flip_prob = 0.5\n",
    "        self.enable_mixup = True\n",
    "        self.use_l1 = True\n",
    "        # dataset paths via env\n",
    "        data_dir = os.getenv('YOLOX_DATA_DIR', 'data/yolox/cam01')\n",
    "        train_ann = os.getenv('YOLOX_TRAIN_ANN', 'annotations/train.json')\n",
    "        val_ann = os.getenv('YOLOX_VAL_ANN', 'annotations/val.json')\n",
    "        train_name = os.getenv('YOLOX_TRAIN_NAME', 'train')\n",
    "        val_name = os.getenv('YOLOX_VAL_NAME', 'val')\n",
    "        self.data_dir = data_dir\n",
    "        self.train_ann = train_ann\n",
    "        self.val_ann = val_ann\n",
    "        self.train_name = train_name\n",
    "        self.val_name = val_name\n",
    "        self.exp_name = 'exp_plate_yolox_s'\n",
    "        self.pretrained = os.getenv('YOLOX_PRETRAIN', '')\n",
    "''')\n",
    "(exp_dir / 'exp_plate_yolox_s.py').write_text(exp_code)\n",
    "print('Wrote exps/yolox/exp_plate_yolox_s.py')\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Quick dataset stats (similar to tools/dataset_stats.py)\n",
    "import json, numpy as np, os\n",
    "with open(os.path.join(DATA_DIR, TRAIN_JSON), 'r') as f:\n",
    "    coco = json.load(f)\n",
    "heights = [float(a['bbox'][3]) for a in coco.get('annotations', []) if isinstance(a.get('bbox'), list)]\n",
    "widths = [float(a['bbox'][2]) for a in coco.get('annotations', []) if isinstance(a.get('bbox'), list)]\n",
    "def pct(v, q):\n",
    "    if not v: return 0.0\n",
    "    arr = np.array(sorted(v)); idx = int(round(q*(len(arr)-1))); return float(arr[max(0,min(len(arr)-1,idx))])\n",
    "print('images:', len(coco.get('images', [])), 'annotations:', len(coco.get('annotations', [])))\n",
    "print('bbox h p50:', pct(heights,0.5), 'p90:', pct(heights,0.9), 'p95:', pct(heights,0.95))\n",
    "print('bbox w p50:', pct(widths,0.5), 'p90:', pct(widths,0.9), 'p95:', pct(widths,0.95))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Train\n",
    "import os, subprocess, sys\n",
    "env = os.environ.copy()\n",
    "env['YOLOX_DATA_DIR'] = DATA_DIR\n",
    "env['YOLOX_TRAIN_ANN'] = TRAIN_JSON\n",
    "env['YOLOX_VAL_ANN'] = VAL_JSON\n",
    "env['YOLOX_TRAIN_NAME'] = TRAIN_NAME\n",
    "env['YOLOX_VAL_NAME'] = VAL_NAME\n",
    "env['YOLOX_MAX_EPOCH'] = str(EPOCHS)\n",
    "env['YOLOX_NO_AUG'] = str(NO_AUG_EPOCHS)\n",
    "if PRETRAIN_CKPT:\n",
    "    env['YOLOX_PRETRAIN'] = PRETRAIN_CKPT\n",
    "cmd = [sys.executable, '-m', 'yolox.tools.train', '-f', 'exps/yolox/exp_plate_yolox_s.py', '-d', '1', '-b', str(BATCH), '--expn', EXPN, '-o', '--fp16']\n",
    "if PRETRAIN_CKPT:\n",
    "    cmd += ['-c', PRETRAIN_CKPT]\n",
    "print('Launching:', ' '.join(cmd))\n",
    "subprocess.call(cmd, env=env)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Export best checkpoint to ONNX and collect artifacts\n",
    "import glob, os, shutil, pathlib\n",
    "out_dir = pathlib.Path('export'); out_dir.mkdir(exist_ok=True)\n",
    "# Find best_ckpt\n",
    "cand = glob.glob(f'YOLOX_outputs/{EXPN}/*/best_ckpt.pth') + glob.glob(f'YOLOX_outputs/{EXPN}/best_ckpt.pth')\n",
    "if not cand:\n",
    "    print('best_ckpt.pth not found; skip export')\n",
    "else:\n",
    "    best = max(cand, key=os.path.getmtime)\n",
    "    print('Using best checkpoint:', best)\n",
    "    # Export ONNX\n",
    "    !python -m yolox.tools.export_onnx -f exps/yolox/exp_plate_yolox_s.py -c "$best" --output-name export/yolox_s.onnx --dynamic\n",
    "    # Copy checkpoint and tensorboard logs if present\n",
    "    shutil.copy2(best, out_dir / 'best_ckpt.pth')\n",
    "    tb = pathlib.Path(f'YOLOX_outputs/{EXPN}/tensorboard')\n",
    "    if tb.exists():\n",
    "        shutil.make_archive('export/tensorboard', 'zip', tb)\n",
    "print('Artifacts in /kaggle/working/export')\n"
   ]
  }
