ALPR_DET_ENGINE=/opt/alpr/models/detector/yolov9-s_plate_fp16.engine
ALPR_OCR_ENGINE=/opt/alpr/models/ocr/ppo_crnn_fp16.engine
ALPR_OCR_CHARSET=/opt/alpr/models/ocr/charset.txt
ALPR_SNAPSHOTS_DIR=/opt/alpr/export/snapshots
ALPR_EVENTS_DB=/opt/alpr/export/events.sqlite
ALPR_ALLOWED_PREFIXES=A,B,D,F,E,Z,T

# Optional OCR postprocess config (YAML). Leave empty to use defaults.
# ALPR_POSTPROC_CONFIG=/opt/alpr/configs/ocr/postproc_indonesia.yaml

# ONNX fallback (workstation) — not used on Jetson TRT path
# ALPR_OCR_ONNX=
# ALPR_PLATE_CONFIG=

