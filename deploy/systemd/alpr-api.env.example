## Python interpreter for the service (override here)
# Point to your venv on Jetson. If you use  (no dot):
PYTHON=/home/iks-ai/Development/ALPR_Jetson/venv/bin/python
# If you use , change to:
# PYTHON=/home/iks-ai/Development/ALPR_Jetson/.venv/bin/python

ALPR_DET_ENGINE=/home/iks-ai/Development/ALPR_Jetson/models/detector/yolov9-s_plate_fp16.engine
ALPR_OCR_ONNX=/home/iks-ai/Development/ALPR_Jetson/models/ocr/cct_s_v1_global.onnx
ALPR_PLATE_CONFIG=/home/iks-ai/Development/ALPR_Jetson/models/ocr/cct_s_v1_global_plate_config.yaml
ALPR_ONNX_PROVIDER=cuda
ALPR_ONNX_GPU_MEM_MB=768
ALPR_SNAPSHOTS_DIR=/home/iks-ai/Development/ALPR_Jetson/export/snapshots
ALPR_EVENTS_DB=/home/iks-ai/Development/ALPR_Jetson/export/events.sqlite
ALPR_ALLOWED_PREFIXES=A,B,D,F,E,Z,T

# Optional OCR postprocess config (YAML). Leave empty to use defaults.
# ALPR_POSTPROC_CONFIG=/home/iks-ai/Development/ALPR_Jetson/configs/ocr/postproc_indonesia.yaml

# TensorRT OCR fallback (only if you build a TRT engine)
# ALPR_OCR_ENGINE=/home/iks-ai/Development/ALPR_Jetson/models/ocr/ppo_crnn_fp16.engine
# ALPR_OCR_CHARSET=/home/iks-ai/Development/ALPR_Jetson/models/ocr/charset.txt

# Note: If ONNX GPU provider is not available on Jetson, set:
# ALPR_ONNX_PROVIDER=cpu
